# Supabase Configuration
# Get these values from your Supabase project dashboard: https://app.supabase.com/project/_/settings/api

# Public Supabase URL (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (required)
# This key is safe to expose in client-side code
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (optional, but required for admin operations)
# ⚠️ NEVER expose this key in client-side code
# Only use in server-side API routes
# Get from: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Impersonation cookie secret (optional)
# Используется для подписи admin_session_backup cookie в /api/admin/impersonate.
# Если не задано — fallback на SUPABASE_JWT_SECRET, потом на SUPABASE_SERVICE_ROLE_KEY.
# Лучше задать отдельный — `openssl rand -base64 32`.
IMPERSONATION_COOKIE_SECRET=

# Cron secret для /api/admin/impersonate/cleanup (закрывает висящие impersonation-сессии).
# Используется заголовком x-cron-secret. Если не задано — endpoint доступен только админу
# с авторизацией Bearer. Для Vercel Cron / supabase scheduled functions — задать.
CRON_SECRET=

# Google Maps API Key (optional, for address autocomplete and maps)
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Google Maps Map ID (optional, for cloud-based map styling)
# Create at: Google Cloud Console → Maps → Map Styles
# This controls the map's visual appearance (colors, POI visibility, road style, etc.)
NEXT_PUBLIC_GOOGLE_MAP_ID=your-map-id

# OpenAI API Key (optional, for AI-generated descriptions)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Stripe (Premium and creator payments)
# Get from: https://dashboard.stripe.com/apikeys
# ⚠️ NEVER expose STRIPE_SECRET_KEY in client-side code
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — get from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs — create in Stripe Dashboard > Products
STRIPE_PRICE_PREMIUM_ONETIME=price_...
STRIPE_PRICE_CREATOR_SERVICE_MONTH=price_...
STRIPE_PRICE_CREATOR_EXPERIENCE_MONTH=price_...
STRIPE_PRICE_CREATOR_ALL_MONTH=price_...
STRIPE_PRICE_EXTRA_LISTING=price_...
# Legacy one-time Premium price ID. Keep only if old code/checkout sessions still use it.
STRIPE_PRICE_ID=price_...
